{
  "name": "pairfob-fork",
  "main": "../../workers/pairfob-origin/src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal", "request_signal_passthrough"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {"BUILD": "fork-build", "P2P_OPEN": "1", "APP_ORIGINS": "https://localhost"},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "pairfob-fork-db",
    "database_id": "4d4a55f0-2941-4645-8f1b-ed5ed5caff9b",
    "migrations_dir": "../../workers/pairfob-origin/migrations"
  }],
  "durable_objects": {"bindings": [
    {"name": "DAEMON_ROOM", "class_name": "DaemonRoom"},
    {"name": "PAIRING_INDEX", "class_name": "PairingIndex"}
  ]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["DaemonRoom", "PairingIndex"]}],
  "assets": {"directory": "../../.dev/cloudflare/public", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "run_worker_first": true},
  "routes": [{"pattern": "pairfob.tingxueren.com", "custom_domain": true}]
}
